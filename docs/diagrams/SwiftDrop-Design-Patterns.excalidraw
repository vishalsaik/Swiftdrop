 behaviour. With State the object\ndecides from its own condition.","fontSize":19,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":19,"containerId":null,"lineHeight":1.4},{"id":"f0000149","type":"frame","x":9250,"y":0,"width":1700,"height":1210.2,"angle":0,"strokeColor":"#868e96","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":868328621,"version":1,"versionNonce":350129529,"isDeleted":false,"boundElements":null,"updated":1792311963275,"link":null,"locked":false,"name":"06 Factory"},{"id":"f0000150","type":"text","x":9300,"y":28,"width":1300.5,"height":42,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":"f0000149","roundness":null,"seed":1334088913,"version":1,"versionNonce":673306854,"isDeleted":false,"boundElements":null,"updated":1792311963275,"link":null,"locked":false,"text":"Factory: decide at request time, not at wiring time","rawText":"Factory: decide at request time, not at wiring time","fontSize":30,"fontFamily":1,"textAlign":"left","verticalAlign":"top","baseline":30,"containerId":null,"lineHeight":1.4},{"id":"f0000151","type":"text","x":9300,"y":82,"width":1534.2499999999998,"height":26.599999999999998,"angle":0,"strokeColor":"#495057","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":"f0000149","roundness":null,"seed":1328463185,"version":1,"versionNonce":1956112167,"isDeleted":false,"boundElements":null,"updated":1792311963275,"link":null,"locked":false,"text":"The right provider depends on order.PaymentType, which is only known after the order is loaded.","rawText":"The right provider depends on order.PaymentType, which is only known after the order is loaded.","fontSize":19,"fontFamily":1,"textAlig